[Unit]
Description=Ptarmigan ARES GUI
After=network-online.target
Wants=network-online.target

[Service]
User=lowres
WorkingDirectory=/home/lowres/ptarmigan/gui
ExecStart=/usr/bin/python3 app.py
Environment=PYTHONUNBUFFERED=1
AmbientCapabilities=CAP_NET_BIND_SERVICE
StandardOutput=append:/home/lowres/ptarmigan/log.txt
StandardError=append:/home/lowres/ptarmigan/log.txt
LimitRTPRIO=99
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
